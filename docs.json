{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RUNNERS Launch API",
  "description": "Launch Solana coins from your own agent, bot or application.",
  "colors": { "primary": "#9DDB00", "light": "#9DDB00", "dark": "#0C41F0" },
  "background": { "color": { "light": "#FFFFFF", "dark": "#101214" } },
  "appearance": { "default": "dark" },
  "fonts": { "family": "Geist" },
  "favicon": "/assets/runners-favicon-v2.svg",
  "logo": { "light": "/assets/runners-header-light-v2.svg", "dark": "/assets/runners-header-dark-v2.svg", "href": "/" },
  "navbar": {
    "links": [{ "label": "Open RUNNERS", "href": "https://runners.family" }],
    "primary": { "type": "button", "label": "Launch a coin", "href": "https://runners.family/create" }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          { "group": "Launch API", "pages": ["index", "guides/launch", "guides/errors"] },
          { "group": "Resources", "pages": ["media-kit"] }
        ]
      },
      { "tab": "API reference", "openapi": "/openapi.json" }
    ]
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/" },
    { "source": "/guides/basics", "destination": "/" },
    { "source": "/api-reference/deployment/get-the-deployment", "destination": "/" },
    { "source": "/guides/amounts", "destination": "/guides/launch#before-you-start" },
    { "source": "/guides/authentication", "destination": "/guides/launch#upload-metadata" },
    { "source": "/guides/recovery", "destination": "/guides/launch#confirm-and-retry" },
    { "source": "/guides/rate-limits", "destination": "/guides/errors#limits" }
  ],
  "api": { "playground": { "display": "interactive", "proxy": true } },
  "footer": { "links": [{ "header": "RUNNERS", "items": [{ "label": "Launchpad", "href": "https://runners.family" }, { "label": "Launch API contract", "href": "/openapi.json" }] }] }
}
